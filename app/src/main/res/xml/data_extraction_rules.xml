<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup: the database and settings are backed up to the user's Google Drive. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="expenses.db" />
        <include domain="database" path="expenses.db-wal" />
        <include domain="database" path="expenses.db-shm" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="expenses.db" />
        <include domain="database" path="expenses.db-wal" />
        <include domain="database" path="expenses.db-shm" />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
